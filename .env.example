# Copie para .env (ignorado pelo git) ou rode `make env`, que gera um com senha aleatória.
# Nunca commite segredos. Use só letras e números na senha (ela entra numa URL).
# Modo de uso:
# - production  = uso real pelo Tailscale com HTTPS (https://<máquina>.<tailnet>.ts.net): cookie de sessão Secure,
#                 Gin em modo release. É o modo certo para o dia a dia (docs/developer-guide/deployment.md).
# - development = teste local em http://localhost:WEB_PORT ou acesso http sem TLS; o cookie sai sem Secure.
# Em production, acessar por http:// (sem o tailscale serve na frente) não mantém o login.
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo

# true = qualquer pessoa pode criar conta sem convite. Mantenha false (o 1º usuário sempre pode se cadastrar).
OPEN_REGISTRATION=false

# Máximo de casas ativas que cada usuário pode criar (padrão 5) e validade absoluta da sessão em dias (padrão 90).
# MAX_HOUSEHOLDS_PER_USER=5
# SESSION_MAX_AGE_DAYS=90

# Consulta de CNPJ (conferir o nome de quem recebe e preencher favorecidos). Só o CNPJ, que é público, sai do servidor.
# "off" desliga; sem a consulta o app funciona igual, só sem conferir o nome.
# CNPJ_LOOKUP_URL=https://brasilapi.com.br/api/cnpj/v1

# Feriados nacionais (para saber o que é dia útil nas datas de receita). Só o ano vai na URL. É, com a consulta de CNPJ,
# a única saída de rede da API. "off" desliga: o app calcula os feriados sozinho (sem estaduais nem municipais).
# HOLIDAYS_URL=https://brasilapi.com.br/api/feriados/v1

POSTGRES_USER=prumia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prumia

# Porta e interface em que o app fica disponível. 127.0.0.1 = só este computador.
WEB_PORT=8080
WEB_BIND=127.0.0.1

# Porta do Postgres no computador, só com `make db-expose` (DBeaver). Sempre em 127.0.0.1.
DB_PORT=5433

# Só para rodar a API fora do Docker (make run / make migrate), apontando para um Postgres seu.
DATABASE_URL=postgres://prumia:prumia@localhost:5432/prumia?sslmode=disable
