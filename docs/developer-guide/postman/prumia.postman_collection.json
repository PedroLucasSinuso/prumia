      "key": "household_id",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "mercado_id",
      "value": ""
    },
    {
      "key": "new_category_id",
      "value": ""
    },
    {
      "key": "invoice_id",
      "value": ""
    },
    {
      "key": "due_date",
      "value": ""
    },
    {
      "key": "due_month",
      "value": ""
    }
