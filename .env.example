# Copie para .env (ignorado pelo git) ou rode `make env`, que gera um com senha aleatória.
# Nunca commite segredos. Use só letras e números na senha (ela entra numa URL).
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo

# true = qualquer pessoa pode criar conta sem convite. Mantenha false (o 1º usuário sempre pode se cadastrar).
OPEN_REGISTRATION=false

POSTGRES_USER=prumia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prumia

# Porta e interface em que o app fica disponível. 127.0.0.1 = só este computador.
WEB_PORT=8080
WEB_BIND=127.0.0.1

# Só para rodar a API fora do Docker (make run / make migrate), apontando para um Postgres seu.
DATABASE_URL=postgres://prumia:prumia@localhost:5432/prumia?sslmode=disable
