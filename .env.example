# Copie para .env (ignorado pelo git) e ajuste. Nunca commite segredos.
APP_ENV=development
HTTP_ADDR=:8080
APP_TIMEZONE=America/Sao_Paulo

# Usado pela API fora do Docker; no compose a URL é montada a partir das variáveis abaixo.
DATABASE_URL=postgres://prumia:prumia@localhost:5432/prumia?sslmode=disable

POSTGRES_USER=prumia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prumia
