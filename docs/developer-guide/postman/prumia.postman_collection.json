            "description": "Use o e-mail e a senha que você cadastrou."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200, cookie httpOnly e casa no corpo\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const me = pm.response.json();",
                  "  pm.expect(me.email).to.eql(\"pedro@exemplo.com\");",
                  "  pm.collectionVariables.set(\"household_id\", me.households[0].id);",
                  "  const c = pm.response.headers.get(\"Set-Cookie\");",
                  "  pm.expect(c).to.include(\"HttpOnly\");",
                  "  pm.expect(c).to.include(\"SameSite=Lax\");",
                  "});"
                ]
              }
