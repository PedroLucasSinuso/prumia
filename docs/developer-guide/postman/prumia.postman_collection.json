    {
      "name": "5. Invoices",
      "item": [
        {
          "name": "Criar invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/households/{{household_id}}/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "households",
                "{{household_id}}",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{category_id}}\",\n  \"description\": \"Aluguel\",\n  \"amountCents\": 150000,\n  \"dueDate\": \"{{due_date}}\",\n  \"notes\": \"teste Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Valores em centavos: 150000 = R$ 1.500,00. A data de vencimento é sempre daqui a 2 dias (script)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 2 * 864e5).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set(\"due_date\", d);",
                  "pm.collectionVariables.set(\"due_month\", d.slice(0, 7) + \"-01\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201, pendente, competência = mês do vencimento\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  const i = pm.response.json();",
                  "  pm.expect(i.status).to.eql(\"pending\");",
                  "  pm.expect(i.amountCents).to.eql(150000);",
                  "  pm.expect(i.competenceMonth).to.eql(pm.collectionVariables.get(\"due_month\"));",
                  "  pm.collectionVariables.set(\"invoice_id\", i.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar invoice inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/households/{{household_id}}/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "households",
                "{{household_id}}",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{category_id}}\",\n  \"description\": \" \",\n  \"amountCents\": 0,\n  \"dueDate\": \"{{due_date}}\",\n  \"competenceMonth\": \"2026-10-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
